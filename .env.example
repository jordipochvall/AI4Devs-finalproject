# Para la demo pública (Vercel + Render + Neon) las variables de producción se configuran en los
# dashboards de esos proveedores, no aquí — ver deploy/README.md § "Demo pública gratuita".

# Base de datos
POSTGRES_DB=novacasino
POSTGRES_USER=novacasino
POSTGRES_PASSWORD=novacasino

# JWT — generar un secreto aleatorio (mínimo 32 bytes; la app rechaza arrancar si es más corto, HU-36)
# openssl rand -base64 48
JWT_SECRET=change-me-generate-a-real-32-byte-secret
JWT_TTL_SECONDS=3600

# IA "ask the AI" (HU-8 / HU-32).
# Por defecto funciona en modo OFFLINE (resumen heurístico local de las métricas), sin coste ni key.
# Para respuestas conversacionales con Claude, pon ANTHROPIC_ENABLED=true y una API key de Anthropic
# (alta en https://console.anthropic.com; las cuentas nuevas suelen tener crédito de prueba; usa Haiku).
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Cuentas semilla/demo (HU-38). Se siembran siempre (útiles para que un evaluador entre sin pedir
# alta: admin@nova.test, operator@nova.test, math@nova.test, player{1,2,3}@nova.test), pero sus
# contraseñas se pueden fijar por entorno en vez de quedar con los valores de desarrollo por defecto
# (admin123/operator123/math123/player123). Recomendado en un VPS público.
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_PASSWORD=
SEED_MATH_PASSWORD=
SEED_PLAYER_PASSWORD=
